# Basic-auth gate in front of my harness. Every value in {$...} comes from
# the auth-proxy service's variables, which .railway/railway.ts declares.
#
#   PORT                Railway injects this; the public domain targets it.
#   AUTH_USER           Login name for the gate.
#   AUTH_PASSWORD_HASH  bcrypt hash — `caddy hash-password --plaintext '...'`.
#   PSYCHEROS_HOST      My harness's private hostname (RAILWAY_PRIVATE_DOMAIN).
#   PSYCHEROS_PORT      The port my harness listens on (3000 in the image).

{
	# Railway handles certificates and I never expose Caddy's admin API.
	admin off
	auto_https off
}

:{$PORT} {
	# Railway's healthcheck must get through without credentials.
	@gated not path /healthz
	basic_auth @gated {
		{$AUTH_USER} {$AUTH_PASSWORD_HASH}
	}

	handle /healthz {
		respond "ok" 200
	}

	handle {
		reverse_proxy {$PSYCHEROS_HOST}:{$PSYCHEROS_PORT} {
			# My events channel is server-sent events and my voice pipeline
			# is WebSockets — both long-lived, neither should be buffered.
			flush_interval -1
		}
	}
}
